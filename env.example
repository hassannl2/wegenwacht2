# Kopieer dit bestand naar ".env" en vul alles in.

# Het adres waarop de site bereikbaar is (zonder / aan het eind).
# Voor testen op je eigen pc: http://localhost:3000
BASE_URL=https://wegenwacht.jouwdomein.nl
PORT=3000
TZ=Europe/Amsterdam

# Een lange willekeurige tekst (minimaal 32 tekens). Verzin er zelf een, deel hem met niemand.
SESSION_SECRET=

# Uit het Discord Developer Portal (stap 1 in de README)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Het ID van jouw Discord-server
DISCORD_GUILD_ID=

# Alleen mensen met deze rol komen binnen. Laat leeg om iedereen in de server binnen te laten.
MEMBER_ROLE_ID=

# Rollen die management zijn (meerdere scheiden met een komma)
MANAGER_ROLE_IDS=
